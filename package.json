{
  "name": "how-to-rsi",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": "22.x" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "content:build": "python3 scripts/build_research.py",
    "content:check": "python3 scripts/check_content.py",
    "test:browser": "node scripts/smoke_browser.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
